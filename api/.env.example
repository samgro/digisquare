DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PORT=3000
# Overture Maps release to import from; see SETUP.md for finding the latest.
OVERTURE_RELEASE=2026-09-23.0

# Auth — generate the secret with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=180
APPLE_BUNDLE_IDENTIFIER=samgro.Hackysack

# Dev only: lets the iOS debug build sign in as a seeded test user with no
# credential. Never enable this where real people have accounts.
ENABLE_TEST_USERS=false

# Cloudflare R2 (avatar storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hackysack-avatars
R2_PUBLIC_BASE_URL=https://avatars.hackysack.app

# Foursquare (Swarm import). Register FOURSQUARE_REDIRECT_URL as the app's
# redirect URI in the Foursquare developer console.
FOURSQUARE_CLIENT_ID=your-foursquare-client-id
FOURSQUARE_CLIENT_SECRET=your-foursquare-client-secret
FOURSQUARE_REDIRECT_URL=http://localhost:3000/imports/swarm/callback
# Our own secret, never shared with Foursquare. Encrypts users' Foursquare
# tokens before they are stored, so a leaked database can't read anyone's
# Swarm history. Generate with: openssl rand -base64 32
# Keep it stable: changing it makes stored tokens unreadable, and everyone has
# to reconnect Swarm before they can sync again (imported checkins are kept).
FOURSQUARE_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Optional, local only: lets `npm run db:branch` name the Neon branch behind
# DATABASE_URL. Make one under Account settings > API keys in the Neon console.
# NEON_PROJECT_ID skips listing every project the key can see.
# NEON_API_KEY=
# NEON_PROJECT_ID=
