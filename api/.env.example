DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
GOOGLE_PLACES_API_KEY=your-google-places-api-key
PORT=3000

# Auth — generate the secret with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=180
APPLE_BUNDLE_IDENTIFIER=samgro.Hackysack

# Cloudflare R2 (avatar storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hackysack-avatars
R2_PUBLIC_BASE_URL=https://avatars.hackysack.app
