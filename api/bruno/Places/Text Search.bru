meta {
  name: Text Search
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/places?lat=37.7749&lng=-122.4194&q=coffee
  body: none
  auth: none
}

params:query {
  lat: 37.7749
  lng: -122.4194
  q: coffee
}

docs {
  Name search for "coffee" around San Francisco, at least 50 km out whatever
  `radius` says. Case-insensitive substring match on the name; places whose
  name starts a word with the query come first, then the most checked-in,
  then the nearest.
}
