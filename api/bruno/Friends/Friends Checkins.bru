meta {
  name: Friends Checkins
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/friends/checkins
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  The Friends tab feed: your friends' checkins and your own, newest first,
  leaving private ones out. Each is the usual checkin plus
  user: { id, name, avatarUrl }. Accepts limit (default 20, max 100) and
  `before`, an ISO 8601 createdAt cursor for the next page.
}
