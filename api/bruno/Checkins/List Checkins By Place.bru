meta {
  name: List Checkins By Place
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/checkins?placeId={{placeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  placeId: {{placeId}}
}

docs {
  Lists checkins filtered to a single place, still limited to your own and
  your friends'.
}
