meta {
  name: Create Private Checkin
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/checkins
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "placeId": "{{placeId}}",
    "message": "Just for me.",
    "visibility": "private"
  }
}

docs {
  Creates a checkin only its owner can see. Expect a 201 with
  `"visibility": "private"`. It shows up in your own List Checkins, but never
  in Friends Checkins (yours included) or in a friend's List Checkins.
}
