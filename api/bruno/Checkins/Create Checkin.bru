meta {
  name: Create Checkin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/checkins
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "placeId": "{{placeId}}",
    "message": "Beautiful day for a walk."
  }
}

vars:post-response {
  checkinId: res.body.id
}

docs {
  Creates a checkin with a message. Expect 201 with the created row, whose
  `placeName`, `placeAddress`, `placeLocality`, `placePrimaryType`,
  `placeTypes` and `location` were snapshotted from the `places` row, not
  taken from the request.

  `placeId` comes from Create Venue in the Places folder (run it first) or
  from any `GET /places` result. The checkin is attributed to whoever the
  bearer token identifies — there is no userId in the body. Confirm `userId`
  in the response matches the id from Sign In As Test User.

  The post-response var captures the new id for Get Checkin and Update
  Checkin, so neither needs a hand-pasted uuid.
}
