meta {
  name: Create Checkin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/checkins
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "googlePlaceId": "ChIJIQBpAG2ahYAR_6128GcTUEo",
    "placeName": "Golden Gate Park",
    "placeAddress": "San Francisco, CA, USA",
    "placePrimaryType": "park",
    "placeTypes": ["park", "point_of_interest", "establishment"],
    "latitude": 37.7694,
    "longitude": -122.4862,
    "message": "Beautiful day for a walk."
  }
}

vars:post-response {
  checkinId: res.body.id
}

docs {
  Creates a checkin with a full venue snapshot and a message. Expect 201 with
  the created row.

  The checkin is attributed to whoever the bearer token identifies — there is
  no userId in the body. Confirm `userId` in the response matches the id from
  Sign In As Test User.

  The post-response var captures the new id for Get Checkin and Update
  Checkin, so neither needs a hand-pasted uuid.
}
