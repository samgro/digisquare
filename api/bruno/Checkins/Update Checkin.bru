meta {
  name: Update Checkin
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/checkins/{{checkinId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "message": "Updated note."
  }
}

docs {
  Updates a checkin's message and/or visibility ("friends" or "private");
  the venue cannot change. Uses the id captured by Create Checkin. Expect
  the venue snapshot fields to be unchanged and `updatedAt` to advance.
}
