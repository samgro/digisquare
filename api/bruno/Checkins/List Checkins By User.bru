meta {
  name: List Checkins By User
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/checkins?userId={{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  userId: {{userId}}
}

docs {
  Lists checkins by a single user. The filter is now a user id (a uuid), not
  the free-form string it used to be — a non-uuid value returns 400.

  {{userId}} is captured by Register or Login, so this shows your own
  checkins. Only your own and your friends' checkins are listed: anyone
  else's user id returns an empty list, not an error, so the response doesn't
  reveal whether that user exists.
}
