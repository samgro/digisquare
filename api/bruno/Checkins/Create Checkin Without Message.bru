meta {
  name: Create Checkin Without Message
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/checkins
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "placeId": "{{placeId}}"
  }
}

docs {
  Creates a checkin with only the required field. Expect a 201 with
  `message` null and the place snapshot filled in from the database.
}
