meta {
  name: List Checkins
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/checkins
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Lists checkins, newest first (limit default 20, max 100). Pass `before`,
  an ISO 8601 createdAt taken from the last row you have, for the next page.
  Only your own checkins and your friends' are included, and a friend's
  private checkins are left out. Each row carries likeCount, commentCount
  and likedByMe.
}
