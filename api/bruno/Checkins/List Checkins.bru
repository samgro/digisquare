meta {
  name: List Checkins
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/checkins
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Lists checkins, newest first, with default pagination (limit 20, offset 0).
  Only your own checkins and your friends' are included.
}
