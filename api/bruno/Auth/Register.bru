meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}",
    "name": "Bruno Tester"
  }
}

vars:post-response {
  accessToken: res.body.accessToken
  refreshToken: res.body.refreshToken
  userId: res.body.user.id
}

docs {
  Creates a password account. Expect a 201 with the auth envelope: `user`,
  `accessToken`, `accessTokenExpiresIn`, `refreshToken` and
  `refreshTokenExpiresAt`.

  The post-response vars capture the tokens and the new user id, so every
  other request in this collection can run without editing anything by hand.

  Note `user.email` is present but `user.hasAppleSignIn` is false, and the
  account's `email_verified_at` stays NULL — there is no verification flow.
}
