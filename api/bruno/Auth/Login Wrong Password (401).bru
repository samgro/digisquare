meta {
  name: Login Wrong Password (401)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "definitely-the-wrong-password"
  }
}

docs {
  A real account with the wrong password. Expect 401 and a body that is
  EXACTLY {"error": "Incorrect email or password"}.

  Note the elapsed time shown in Bruno's response pane — you are comparing it
  against Unknown Email (401), the next request.
}
