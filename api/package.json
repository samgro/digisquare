{
  "name": "hackysack-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:record": "tsx scripts/record-ranking-fixtures.ts",
    "overture:import": "tsx scripts/import-overture-places.ts",
    "overture:import-extents": "tsx scripts/import-overture-extents.ts",
    "coverage:seed": "tsx scripts/coverage-seed.ts",
    "coverage:refresh": "tsx scripts/coverage-refresh.ts",
    "coverage:retry": "tsx scripts/coverage-retry.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-test-users": "tsx scripts/seed-test-users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@duckdb/node-api": "^1.5.5-r.5",
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^0.10.3",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.11",
    "jose": "^5.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
